  "conflict_rules": [
    {
      "rule": "length_too_short",
      "condition": "length < nominal_diameter * 2",
      "severity": "warning",
      "message": "Bolt length is less than 2× diameter. Engagement may be insufficient."
    },
    {
      "rule": "non_standard_diameter",
      "condition": "nominal_diameter not in [1.6,2,2.5,3,4,5,6,8,10,12,14,16,20,24,30,36,42,48,56,64]",
