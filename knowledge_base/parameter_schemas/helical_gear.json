{
  "component_type": "helical_gear",
  "schema_version": "1.0",
  "standards_family": ["AGMA_2101", "ISO_21771"],
  "description": "External involute helical gear with hub and central bore",
  "parameters": [
    {
      "name": "module",
      "required": true,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0.5,
      "max_value": 50.0,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_21771",
      "description": "Transverse module"
    },
    {
      "name": "teeth",
      "required": true,
      "data_type": "int",
      "unit": null,
      "min_value": 6,
      "max_value": 400,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_21771",
      "description": "Number of teeth"
    },
    {
      "name": "pressure_angle",
      "required": true,
      "data_type": "float",
      "unit": "degrees",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 20.0,
      "allowed_values": [14.5, 20.0, 25.0],
      "depends_on": [],
      "standard_reference": "AGMA_2101",
      "description": "Transverse pressure angle"
    },
    {
      "name": "face_width",
      "required": true,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "8 * module",
      "formula_range": "8*module to 16*module",
      "depends_on": ["module"],
      "standard_reference": "AGMA_2101",
      "description": "Gear face width"
    },
    {
      "name": "bore_diameter",
      "required": true,
      "data_type": "float",
      "unit": "mm",
      "min_value": 1.0,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_286",
      "description": "Central bore diameter"
    },
    {
      "name": "material",
      "required": true,
      "data_type": "string",
      "unit": null,
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "context_hint",
      "hint_map": {
        "general_purpose": "Steel_1045",
        "high_performance": "Steel_4140_HT",
        "lightweight": "Aluminum_7075",
        "low_cost": "Cast_Iron_G3000",
        "non_metallic": "Nylon_PA66"
      },
      "fallback_default": "Steel_1045",
      "depends_on": [],
      "standard_reference": "AGMA_2101",
      "description": "Gear material"
    },
    {
      "name": "pitch_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "module * teeth",
      "depends_on": ["module", "teeth"],
      "standard_reference": "ISO_21771",
      "description": "Pitch diameter"
    },
    {
      "name": "base_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "module * teeth * cos(radians(pressure_angle))",
      "depends_on": ["module", "teeth", "pressure_angle"],
      "standard_reference": "ISO_21771",
      "description": "Base circle diameter"
    },
    {
      "name": "addendum",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "1.0 * module",
      "depends_on": ["module"],
      "standard_reference": "ISO_21771",
      "description": "Addendum height"
    },
    {
      "name": "dedendum",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "1.25 * module",
      "depends_on": ["module"],
      "standard_reference": "ISO_21771",
      "description": "Dedendum height"
    },
    {
      "name": "outer_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "module * teeth + 2 * module",
      "depends_on": ["module", "teeth"],
      "standard_reference": "ISO_21771",
      "description": "Outside diameter"
    },
    {
      "name": "root_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "module * teeth - 2.5 * module",
      "depends_on": ["module", "teeth"],
      "standard_reference": "ISO_21771",
      "description": "Root diameter"
    },
    {
      "name": "hub_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "General",
      "description": "Optional hub diameter"
    },
    {
      "name": "hub_length",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": ["hub_diameter"],
      "standard_reference": "General",
      "description": "Optional hub length"
    },
    {
      "name": "keyway",
      "required": false,
      "data_type": "string",
      "unit": null,
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "allowed_values": ["none", "square", "woodruff"],
      "depends_on": [],
      "standard_reference": "DIN_6885",
      "description": "Optional keyway type"
    },
    {
      "name": "chamfer",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 0.5,
      "depends_on": [],
      "standard_reference": "General",
      "description": "Edge chamfer on gear face"
    },
    {
      "name": "quality_grade",
      "required": false,
      "data_type": "int",
      "unit": null,
      "min_value": 3,
      "max_value": 12,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 6,
      "depends_on": [],
      "standard_reference": "AGMA_2101",
      "description": "AGMA quality number"
    },
    {
      "name": "helix_angle",
      "required": true,
      "data_type": "float",
      "unit": "degrees",
      "min_value": 5.0,
      "max_value": 45.0,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 15.0,
      "depends_on": [],
      "standard_reference": "AGMA_2101",
      "description": "Helix angle"
    },
    {
      "name": "hand",
      "required": true,
      "data_type": "enum",
      "unit": null,
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "allowed_values": ["left", "right"],
      "depends_on": [],
      "standard_reference": "AGMA_2101",
      "description": "Helix hand"
    },
    {
      "name": "normal_module",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "module * cos(radians(helix_angle))",
      "depends_on": ["module", "helix_angle"],
      "standard_reference": "ISO_21771",
      "description": "Normal module"
    },
    {
      "name": "normal_pressure_angle",
      "required": false,
      "data_type": "float",
      "unit": "degrees",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "degrees(atan(tan(radians(pressure_angle)) * cos(radians(helix_angle))))",
      "depends_on": ["pressure_angle", "helix_angle"],
      "standard_reference": "ISO_21771",
      "description": "Normal pressure angle"
    },
    {
      "name": "axial_pitch",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "(pi * module) / tan(radians(helix_angle))",
      "depends_on": ["module", "helix_angle"],
      "standard_reference": "ISO_21771",
      "description": "Axial pitch"
    },
    {
      "name": "lead",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "formula",
      "formula": "axial_pitch * teeth",
      "depends_on": ["axial_pitch", "teeth"],
      "standard_reference": "ISO_21771",
      "description": "Helix lead"
    }
  ],
  "conflict_rules": [
    {
      "rule": "undercut_risk",
      "condition": "teeth < 17 and pressure_angle == 20.0",
      "severity": "warning",
      "message": "Fewer than 17 teeth at 20° risks undercut. Consider profile shift or increase teeth."
    },
    {
      "rule": "undercut_risk_25",
      "condition": "teeth < 13 and pressure_angle == 25.0",
      "severity": "warning",
      "message": "Fewer than 13 teeth at 25° risks undercut."
    },
    {
      "rule": "face_width_max",
      "condition": "face_width > 16 * module",
      "severity": "error",
      "message": "Face width exceeds hobbing L/D ratio limit. Reduce face width or increase module."
    },
    {
      "rule": "face_width_min",
      "condition": "face_width < 6 * module",
      "severity": "warning",
      "message": "Face width below minimum recommended. Gear may be too narrow for load."
    },
    {
      "rule": "bore_too_large",
      "condition": "bore_diameter > 0.5 * pitch_diameter",
      "severity": "error",
      "message": "Bore too large relative to pitch diameter. Insufficient wall material remaining."
    },
    {
      "rule": "hub_without_diameter",
      "condition": "hub_length is not None and hub_diameter is None",
      "severity": "error",
      "message": "Hub length specified without hub diameter. Both required or neither."
    },
    {
      "rule": "helix_angle_too_high",
      "condition": "helix_angle > 35.0",
      "severity": "warning",
      "message": "Helix angle above 35° generates high axial thrust loads. Ensure thrust bearings are specified."
    },
    {
      "rule": "face_width_helical_min",
      "condition": "face_width < 2 * axial_pitch",
      "severity": "warning",
      "message": "Face width less than 2× axial pitch. Gear contact ratio will be low."
    }
  ]
}
