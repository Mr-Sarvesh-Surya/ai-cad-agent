{
  "component_type": "through_hole",
  "schema_version": "1.0",
  "standards_family": ["ISO_286"],
  "description": "Cylindrical through hole with tolerance and finish specification",
  "parameters": [
    {
      "name": "diameter",
      "required": true,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0.5,
      "max_value": 500.0,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_286",
      "description": "Hole diameter"
    },
    {
      "name": "depth",
      "required": true,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0.5,
      "max_value": 5000.0,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_286",
      "description": "Hole depth"
    },
    {
      "name": "tolerance_class",
      "required": false,
      "data_type": "string",
      "unit": null,
      "min_value": null,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": "H7",
      "depends_on": [],
      "standard_reference": "ISO_286",
      "description": "Hole tolerance class"
    },
    {
      "name": "surface_finish_ra",
      "required": false,
      "data_type": "float",
      "unit": "um",
      "min_value": 0.1,
      "max_value": 25.0,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 1.6,
      "depends_on": [],
      "standard_reference": "ISO_1302",
      "description": "Surface roughness Ra"
    },
    {
      "name": "chamfer",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": 0,
      "max_value": null,
      "default_resolvable": true,
      "resolution_method": "standards_default",
      "default_value": 0.5,
      "depends_on": [],
      "standard_reference": "General",
      "description": "Entry chamfer"
    },
    {
      "name": "thread",
      "required": false,
      "data_type": "string",
      "unit": null,
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "ISO_261",
      "description": "Optional thread specification"
    },
    {
      "name": "countersink_angle",
      "required": false,
      "data_type": "float",
      "unit": "degrees",
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "General",
      "description": "Optional countersink angle"
    },
    {
      "name": "counterbore_diameter",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": [],
      "standard_reference": "General",
      "description": "Optional counterbore diameter"
    },
    {
      "name": "counterbore_depth",
      "required": false,
      "data_type": "float",
      "unit": "mm",
      "min_value": null,
      "max_value": null,
      "default_resolvable": false,
      "resolution_method": "ask_user",
      "depends_on": ["counterbore_diameter"],
      "standard_reference": "General",
      "description": "Optional counterbore depth"
    }
  ],
  "conflict_rules": [
    {
      "rule": "counterbore_without_depth",
      "condition": "counterbore_diameter is not None and counterbore_depth is None",
      "severity": "error",
      "message": "Counterbore diameter specified without depth. Both required."
    },
    {
      "rule": "counterbore_too_small",
      "condition": "counterbore_diameter is not None and counterbore_diameter <= diameter",
      "severity": "error",
      "message": "Counterbore diameter must be larger than hole diameter."
    },
    {
      "rule": "countersink_and_counterbore",
      "condition": "countersink_angle is not None and counterbore_diameter is not None",
      "severity": "error",
      "message": "Cannot have both countersink and counterbore on the same hole."
    }
  ]
}
